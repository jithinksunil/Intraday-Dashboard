# Copy this file to .env and fill it in. .env is gitignored.
#
# Create an app at https://myapi.fyers.in/dashboard (free). Use the values it gives you:
FYERS_APP_ID=XXXXXXXXXX-100
FYERS_SECRET_KEY=
# Must match the Redirect URL you set on the app exactly. Any URL works; you only copy
# the address bar after login, nothing needs to be listening there.
FYERS_REDIRECT_URI=https://127.0.0.1/
